rules_version = '2';

// Firestore security rules for the House of Aspirants learning platform.
// Paste into Firebase Console → Firestore Database → Rules → Publish.
//
//   users/{uid}                       profile + merged progress stats (private)
//   users/{uid}/attempts/{resultId}   one document per completed quiz (private)
//   scores/{uid}                      ONE public leaderboard row per student
//
// A scores row carries `pts` (all-time points) plus exactly three live period
// fields named d<yyyymmdd>, w<yyyyww> and m<yyyymm> (written by
// assets/js/auth.js → nextScore). Only the owner can write, points only go
// up, each write can add at most 10 per newly answered question (+50), and
// every period field moves in lock-step with `pts`.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);
      match /attempts/{attemptId} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    match /scores/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && validScore(request.resource.data, uid)
        && request.resource.data.answered <= 200
        && request.resource.data.pts <= request.resource.data.answered * 10 + 50
        && periodsEqual(request.resource.data, periods(request.resource.data), request.resource.data.pts);

      allow update: if isOwner(uid)
        && validScore(request.resource.data, uid)
        && validStep(request.resource.data, resource.data);

      allow delete: if isOwner(uid);
    }

    // The three period fields = every key that is not a fixed field.
    function periods(d) {
      return d.keys().removeAll(['uid', 'name', 'photo', 'pts', 'quizzes', 'correct',
        'answered', 'best', 'days', 'streak', 'per', 'last', 'updatedAt']);
    }

    function isPeriod(k) {
      return k.matches('[dwm][0-9]{6,8}');
    }

    function periodsEqual(d, p, value) {
      return d[p[0]] == value && d[p[1]] == value && d[p[2]] == value;
    }

    function periodsStep(d, o, p, gain) {
      return d[p[0]] == o.get(p[0], 0) + gain
        && d[p[1]] == o.get(p[1], 0) + gain
        && d[p[2]] == o.get(p[2], 0) + gain;
    }

    function validScore(d, uid) {
      return d.uid == uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.pts is int && d.pts >= 0
        && d.quizzes is int && d.quizzes >= 0
        && d.correct is int && d.correct >= 0
        && d.answered is int && d.answered >= 0
        && d.correct <= d.answered
        && periods(d).size() == 3
        && isPeriod(periods(d)[0]) && isPeriod(periods(d)[1]) && isPeriod(periods(d)[2]);
    }

    function validStep(d, o) {
      return d.pts >= o.pts
        && d.answered > o.answered
        && d.answered - o.answered <= 200
        && d.pts - o.pts <= (d.answered - o.answered) * 10 + 50
        && periodsStep(d, o, periods(d), d.pts - o.pts);
    }
  }
}
