    {
      "id": "06-025",
      "number": 25,
      "question": "A two-digit number is 7 times its digit sum. If its units digit is 4, find the number.",
      "options": [
        {
          "label": "A",
          "text": "48"
        },
        {
          "label": "B",
          "text": "74"
        },
