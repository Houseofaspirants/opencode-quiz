    },
    {
      "id": "06-019",
      "number": 19,
      "question": "3/7 of a number is 32 less than 5/9 of the same number. Find the number.",
      "options": [
        {
          "label": "A",
          "text": "252"
        },
        {
          "label": "B",
          "text": "126"
        },
        {
          "label": "C",
          "text": "504"
        },
        {
          "label": "D",
          "text": "189"
        }
      ],
      "answer": "A",
      "explanation": "(5/9 − 3/7)x = 8x/63 = 32, so x = 32 × 63/8 = 252."
    },
    {
      "id": "06-020",
      "number": 20,
      "question": "After 20% of the fuel in a tank is used, 60 litres are added. Then 25% of the fuel now in the tank is drawn out, leaving 195 litres. Find the initial quantity in litres.",
      "options": [
        {
          "label": "A",
          "text": "300"
        },
        {
          "label": "B",
          "text": "200"
        },
        {
          "label": "C",
          "text": "325"
        },
        {
          "label": "D",
          "text": "250"
        }
      ],
      "answer": "D",
      "explanation": "Before the last withdrawal, fuel = 195 ÷ 0.75 = 260 litres; initial fuel = (260 − 60) ÷ 0.80 = 250 litres."
    },
    {
      "id": "06-021",
      "number": 21,
      "question": "The sum of two numbers is 126. The larger exceeds twice the smaller by 12. Find their difference.",
