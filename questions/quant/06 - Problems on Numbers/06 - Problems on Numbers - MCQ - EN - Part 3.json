    {
      "id": "06-074",
      "number": 74,
      "question": "If x + y = 26 and x − y = 10, find (x² + y²)/2.",
      "options": [
        {
          "label": "A",
          "text": "388"
        },
        {
          "label": "B",
          "text": "144"
        },
        {
          "label": "C",
          "text": "194"
        },
        {
          "label": "D",
          "text": "288"
        }
      ],
      "answer": "C",
      "explanation": "(x² + y²)/2 = [(x + y)² + (x − y)²]/4 = (676 + 100)/4 = 194."
    },
    {
      "id": "06-075",
      "number": 75,
      "question": "A two-digit number has digit sum 10. Adding 36 reverses its digits. Find the product of the original number and its tens digit.",
      "options": [
        {
          "label": "A",
          "text": "259"
        },
        {
          "label": "B",
          "text": "111"
        },
        {
          "label": "C",
          "text": "37"
        },
        {
          "label": "D",
          "text": "74"
        }
      ],
      "answer": "B",
      "explanation": "Units − tens = 36 ÷ 9 = 4; with digit sum 10, tens = 3 and number = 37; product = 111."
    }
  ]
