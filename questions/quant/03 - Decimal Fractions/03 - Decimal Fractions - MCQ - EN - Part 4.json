    {
      "id": "03-082",
      "number": 82,
      "question": "Data sufficiency: How many litres of petrol did Aman buy? I. His bill was ₹971.25 after a reduction of ₹4.50 per litre from the displayed rate of ₹97 per litre. II. After he used 0.4 of the petrol bought, 6.3 litres remained.",
      "options": [
        {
          "label": "A",
          "text": "Each statement alone is sufficient."
        },
        {
          "label": "B",
          "text": "Statement II alone is sufficient; I alone is not."
        },
        {
          "label": "C",
          "text": "Both statements together are sufficient, but neither alone is sufficient."
        },
        {
          "label": "D",
          "text": "Statement I alone is sufficient; II alone is not."
        }
      ],
      "answer": "A",
      "explanation": "I gives 971.25/(97 − 4.50) = 10.5 litres. II gives 6.3/(1 − 0.4) = 10.5 litres, so each statement alone is sufficient."
    },
