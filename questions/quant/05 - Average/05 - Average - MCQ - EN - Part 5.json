    {
      "id": "05-106",
      "number": 106,
      "question": "A 20-member squad averages 58 kg. Replacing its lightest member by an 82 kg member raises the average by 1.5 kg. The new member is then replaced by a 62 kg member. Find the net increase in average weight from the original squad, in kg.",
      "options": [
        {
          "label": "A",
          "text": "1"
        },
        {
          "label": "B",
          "text": "2.5"
        },
        {
          "label": "C",
          "text": "0.5"
        },
        {
          "label": "D",
          "text": "0.75"
        }
      ],
      "answer": "C",
      "explanation": "First member weighed 82 − 20 × 1.5 = 52 kg. Net increase = (62 − 52) ÷ 20 = 0.5 kg."
    },
    {
      "id": "05-107",
      "number": 107,
      "question": "A group of 18 has average score 55. 2 new members join with equal scores and the average becomes 57. Find each newcomer’s score.",
      "options": [
