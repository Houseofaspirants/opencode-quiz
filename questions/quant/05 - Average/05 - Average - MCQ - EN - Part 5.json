    {
      "id": "05-101",
      "number": 101,
      "question": "Find the average of all 3-digit integers that leave remainder 2 when divided by 40.",
      "options": [
        {
          "label": "A",
          "text": "542"
        },
        {
          "label": "B",
          "text": "522"
        },
        {
          "label": "C",
          "text": "562"
        },
        {
          "label": "D",
          "text": "550"
        }
      ],
      "answer": "A",
      "explanation": "First term = 122 and last term = 962. Average = (122 + 962) ÷ 2 = 542."
    },
    {
      "id": "05-102",
      "number": 102,
      "question": "Daily sales average ₹3,500 over days 1–8 and ₹3,800 over days 3–10. Days 1 and 2 average ₹2,900. Find the average sales over days 9 and 10, in ₹.",
      "options": [
        {
          "label": "A",
          "text": "3800"
        },
        {
          "label": "B",
          "text": "4100"
        },
        {
          "label": "C",
          "text": "5300"
        },
        {
          "label": "D",
          "text": "3500"
        }
      ],
      "answer": "B",
      "explanation": "The entering pair’s total exceeds the leaving pair by 8 × 300 = ₹2400. Its average = 2900 + 2400 ÷ 2 = ₹4100."
    },
    {
      "id": "05-103",
      "number": 103,
      "question": "For 30 entries, a clerk omits 60, records 48 as 84, and divides the resulting total by 29 to get 54. Find the correct average.",
      "options": [
        {
          "label": "A",
          "text": "53"
        },
        {
          "label": "B",
          "text": "55"
        },
        {
          "label": "C",
          "text": "52"
        },
        {
          "label": "D",
          "text": "54.2"
        }
      ],
      "answer": "A",
      "explanation": "Correct total = 29 × 54 + 60 − 84 + 48 = 1590. Correct average = 1590 ÷ 30 = 53."
    },
    {
