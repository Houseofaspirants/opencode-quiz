    {
      "id": "05-026",
      "number": 26,
      "question": "6 consecutive even integers average 29. Find the average of the smallest 2 integers.",
      "options": [
        {
          "label": "A",
          "text": "24"
        },
        {
          "label": "B",
          "text": "26"
        },
        {
          "label": "C",
          "text": "25"
        },
        {
          "label": "D",
          "text": "27"
        }
      ],
      "answer": "C",
      "explanation": "The middle pair is 28 and 30, so the smallest pair is 24 and 26. Its average = (24 + 26) ÷ 2 = 25."
    },
    {
      "id": "05-027",
      "number": 27,
      "question": "A library club has 16 members with average age 25 years. 4 members join and the average becomes 27 years. Find the average age of the newcomers in years.",
      "options": [
        {
          "label": "A",
          "text": "33"
        },
        {
          "label": "B",
          "text": "32"
        },
        {
          "label": "C",
          "text": "37"
        },
        {
          "label": "D",
          "text": "35"
        }
      ],
      "answer": "D",
      "explanation": "Newcomers average = 27 + 16 × (27 − 25) ÷ 4 = 35 years."
    },
    {
      "id": "05-028",
      "number": 28,
      "question": "4 years ago, 20 pupils averaged 12 years. Today, 5 of them averaging 18 years leave and 5 pupils averaging 13 years join. Find the present average age of the class in years.",
      "options": [
