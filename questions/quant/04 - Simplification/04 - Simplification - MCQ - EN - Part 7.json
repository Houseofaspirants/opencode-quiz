      "id": "04-151",
      "number": 151,
      "question": "The block 27 repeats endlessly in 0.272727… . What is 11 times this number plus 0.75?",
      "options": [
        {
          "label": "A",
          "text": "3.75"
        },
        {
          "label": "B",
          "text": "3.25"
        },
        {
          "label": "C",
          "text": "30.75"
        },
        {
          "label": "D",
          "text": "2.75"
        }
      ],
      "answer": "A",
      "explanation": "The recurring value is 27/99 = 3/11; hence 11 × (3/11) + 0.75 = 3.75."
    },
