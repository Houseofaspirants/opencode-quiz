      "id": "04-026",
      "number": 26,
      "question": "A number was multiplied by 46 instead of 64, making the result 1458 too small. Find the number.",
      "options": [
        {
          "label": "A",
          "text": "18"
        },
        {
          "label": "B",
          "text": "90"
        },
        {
          "label": "C",
          "text": "72"
        },
        {
          "label": "D",
          "text": "81"
        }
      ],
      "answer": "D",
      "explanation": "The error is (64 − 46) times the number; hence the number is 1458 ÷ 18 = 81."
    },
