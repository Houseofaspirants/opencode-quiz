{
  "name": "house-of-aspirants-quiz-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "House of Aspirants - Quiz Portal for Punjab Police, PSSSB & Competitive Exam aspirants. Pure HTML/CSS/JS + JSON question bank. No backend required.",
  "scripts": {
    "publish": "bash publish.sh",
    "build": "node scripts/build-index.mjs",
    "content": "node scripts/build_content_manifest.ts",
    "content:check": "node scripts/build_content_manifest.ts --check",
    "typecheck": "npx --yes --package typescript@5.6.3 tsc --noEmit -p jsconfig.json",
    "dev": "node scripts/build-index.mjs && npx --yes serve .",
    "start": "npx --yes serve ."
  },
  "keywords": [
    "quiz",
    "punjab-police",
    "psssb",
    "competitive-exams",
    "mcq",
    "static-site",
    "vercel"
  ],
  "license": "MIT"
}
